# Learnora – Configuration
# Copy this file to api/.env and fill in your values.
# Never commit api/.env to git.

DB_HOST=localhost
DB_NAME=learnora_db
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# Generate a random secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_64_CHAR_STRING

# ── Jitsi as a Service (JaaS) ─────────────────────────────────
# Sign up at https://jaas.8x8.vc and create a new app.
# APP_ID  → Overview tab
# API_KEY_ID → API Keys tab (looks like: vpaas-magic-cookie-xxx/keyId)
# Private key → download the .pk file from the API Keys tab
JAAS_APP_ID=vpaas-magic-cookie-REPLACE_ME
JAAS_API_KEY_ID=vpaas-magic-cookie-REPLACE_ME/KEY_ID_REPLACE_ME

# Option A (recommended): path to the .pk file on the server
JAAS_PRIVATE_KEY_FILE=/path/to/jaas-private.pk

# Option B: paste the entire private key inline (all on one line using \n)
# JAAS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
